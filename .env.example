# Settings for the Retail Predictive Analytics Engine.
# Every setting has a default, so nothing here is required.
# To change one on Windows for the current Command Prompt:  set DB_PATH=C:\path\to\other.db

# Where the SQLite database lives
DB_PATH=data/db/retail.db

# Which saved forecast model the API loads (file in models/)
FORECAST_MODEL_VERSION=forecast_lgbm_v1

# Random seed used for data generation and model training
SEED=42